+@implementation FBSimulator_TranslationRequest_ApplicationForPid
+
+- (instancetype)initWithNestedFormat:(BOOL)nestedFormat pid:(pid_t)pid
+{
+  self = [super initWithNestedFormat:nestedFormat];
+  if (!self) {
+    return nil;
+  }
+
+  _pid = pid;
+
+  return self;
+}
+
+- (AXPTranslationObject *)performWithTranslator:(AXPTranslator *)translator
+{
+  // AXPTranslator.h is a class-dump, not SDK truth: guard the per-pid selectors at runtime.
+  // NSLog diagnostics go to stderr so CLI probes record which selector was available and used.
+  BOOL respondsToPid = [translator respondsToSelector:@selector(translationApplicationObjectForPid:)];
+  BOOL respondsToPidNumber = [translator respondsToSelector:@selector(_translationApplicationObjectForPidNumber:)];
+  NSLog(@"ApplicationForPid request: pid=%d respondsTo translationApplicationObjectForPid:=%d _translationApplicationObjectForPidNumber:=%d", self.pid, respondsToPid, respondsToPidNumber);
+  AXPTranslationObject *translation = nil;
+  if (respondsToPid) {
+    translation = [translator translationApplicationObjectForPid:self.pid];
+    NSLog(@"ApplicationForPid request: translationApplicationObjectForPid: returned %@", translation);
+  }
+  if (translation == nil && respondsToPidNumber) {
+    translation = [translator _translationApplicationObjectForPidNumber:@(self.pid)];
+    NSLog(@"ApplicationForPid request: _translationApplicationObjectForPidNumber: returned %@", translation);
+  }
+  // The bridgeDelegateToken is set post-hoc by the dispatcher, exactly as for the frontmost path.
+  return translation;
+}
